# ==========================================
# EduGrade AI - 教学作业上传与自动评分系统配置
# ==========================================

# 1. 服务基础配置
APP_NAME="EduGrade AI 教学作业上传与自动评分系统"
APP_ENV="development"
SECRET_KEY="edugrade-super-secret-jwt-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 2. 数据库配置 (默认使用本地 SQLite，生产环境可无缝切换至 PostgreSQL)
# SQLite 示例:
DATABASE_URL="sqlite:///./edugrade.db"
# PostgreSQL 切换示例 (取消下方注释并修改连接串即可):
# DATABASE_URL="postgresql+psycopg2://postgres:password@localhost:5432/edugrade_db"

# 3. LLM 统一抽象层配置 (支持 gemini | openai_compatible | mock)
LLM_PROVIDER="gemini"

# Google Gemini API 配置 (默认模型支持原生多模态图片与扫描版 PDF 读取)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# 预留 OpenAI 兼容接口配置 (如 DeepSeek / Qwen / OpenAI)
OPENAI_API_KEY="your-openai-compatible-api-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o"

# 4. 文件上传目录与大小限制
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25
